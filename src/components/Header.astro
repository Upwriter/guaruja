---
import { Image } from 'astro:assets';
import { CATEGORIES, SITE_TITLE } from '../consts';
import logo from '../assets/logo.png';
---

<header class="border-b border-sea-100 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold text-sea-800">
      <Image src={logo} alt="" width={40} height={40} class="h-10 w-10" />
      {SITE_TITLE}
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium text-sea-700">
        {
          CATEGORIES.map((cat) => (
            <li>
              <a href={`/${cat.slug}/`} class="hover:text-sea-900 hover:underline">
                {cat.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/busca/"
        aria-label="Buscar no site"
        class="rounded-md p-2 text-sea-700 hover:bg-sea-50"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3-3" stroke-linecap="round"></path>
        </svg>
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center rounded-md p-2 text-sea-700 hover:bg-sea-50"
          aria-label="Abrir menu"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav
          aria-label="Principal"
          class="absolute right-0 top-full z-40 mt-2 w-64 rounded-lg border border-sea-100 bg-white p-3 shadow-lg"
        >
          <ul class="flex flex-col gap-1 text-sm font-medium text-sea-700">
            {
              CATEGORIES.map((cat) => (
                <li>
                  <a href={`/${cat.slug}/`} class="block rounded px-3 py-2 hover:bg-sea-50">
                    {cat.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
