---
import { Image } from 'astro:assets';
import { CATEGORIES, SITE_TITLE } from '../consts';
import logo from '../assets/logo.png';
---

<header class="border-b border-sea-100 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold text-sea-800">
      <Image src={logo} alt="" width={40} height={40} class="h-10 w-10" />
      {SITE_TITLE}
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm font-medium text-sea-700">
        <li><a href="/" class="hover:text-sea-900 hover:underline">Início</a></li>
        <li><a href="/blog/" class="hover:text-sea-900 hover:underline">Blog</a></li>
        <li>
          <details class="group relative">
            <summary
              class="flex cursor-pointer list-none items-center gap-1 hover:text-sea-900 hover:underline"
            >
              Sobre o Guarujá
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <ul class="absolute left-0 top-full z-40 mt-2 w-56 rounded-lg border border-sea-100 bg-white p-2 shadow-lg">
              {
                CATEGORIES.map((cat) => (
                  <li>
                    <a href={`/${cat.slug}/`} class="block rounded px-3 py-2 hover:bg-sea-50">
                      {cat.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        <li><a href="/sobre-nos/" class="hover:text-sea-900 hover:underline">Sobre nós</a></li>
        <li><a href="/contato/" class="hover:text-sea-900 hover:underline">Contato</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/busca/"
        aria-label="Buscar no site"
        class="rounded-md p-2 text-sea-700 hover:bg-sea-50"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3-3" stroke-linecap="round"></path>
        </svg>
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center rounded-md p-2 text-sea-700 hover:bg-sea-50"
          aria-label="Abrir menu"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav
          aria-label="Principal"
          class="absolute right-0 top-full z-40 mt-2 w-64 rounded-lg border border-sea-100 bg-white p-3 shadow-lg"
        >
          <ul class="flex flex-col gap-1 text-sm font-medium text-sea-700">
            <li><a href="/" class="block rounded px-3 py-2 hover:bg-sea-50">Início</a></li>
            <li><a href="/blog/" class="block rounded px-3 py-2 hover:bg-sea-50">Blog</a></li>
            <li class="mt-1 px-3 pt-2 text-xs font-semibold uppercase tracking-wide text-sea-500">
              Sobre o Guarujá
            </li>
            {
              CATEGORIES.map((cat) => (
                <li>
                  <a href={`/${cat.slug}/`} class="block rounded px-3 py-2 hover:bg-sea-50">
                    {cat.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-sea-100 pt-1">
              <a href="/sobre-nos/" class="block rounded px-3 py-2 hover:bg-sea-50">Sobre nós</a>
            </li>
            <li>
              <a href="/contato/" class="block rounded px-3 py-2 hover:bg-sea-50">Contato</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
