---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-4 text-sm text-sea-600">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === items.length - 1 ? (
            <span aria-current="page" class="font-medium text-sea-800">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-sea-900 hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
