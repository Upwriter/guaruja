---
// Botões de compartilhamento simples: apenas links diretos para cada rede,
// sem nenhum script/SDK de terceiros carregado na página.
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="not-prose my-6 flex flex-wrap items-center gap-2">
  <span class="text-sm font-medium text-sea-700">Compartilhar:</span>

  <a
    href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1.5 rounded-md bg-[#25D366] px-3 py-1.5 text-sm font-medium text-white hover:opacity-90"
    aria-label="Compartilhar no WhatsApp"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
      <path
        d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.42 1.26 4.86L2 22l5.34-1.4a9.9 9.9 0 0 0 4.7 1.2h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.8 14.24c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.31-1.64-.6-2.87-1.24-4.74-4.13-4.88-4.32-.14-.19-1.16-1.55-1.16-2.96s.72-2.1.98-2.39c.26-.28.56-.35.75-.35h.54c.17 0 .4-.06.63.48.24.56.8 1.95.87 2.09.07.14.11.31.02.5-.09.19-.14.31-.28.48-.14.16-.3.36-.42.49-.14.14-.29.29-.13.57.17.28.75 1.24 1.61 2 1.1.98 2.03 1.29 2.31 1.43.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.64.77 1.92.91.28.14.47.21.54.33.07.12.07.68-.17 1.36Z"
      ></path>
    </svg>
    WhatsApp
  </a>

  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1.5 rounded-md bg-[#1877F2] px-3 py-1.5 text-sm font-medium text-white hover:opacity-90"
    aria-label="Compartilhar no Facebook"
  >
    Facebook
  </a>

  <a
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1.5 rounded-md bg-sea-900 px-3 py-1.5 text-sm font-medium text-white hover:opacity-90"
    aria-label="Compartilhar no X (Twitter)"
  >
    X
  </a>

  <button
    type="button"
    data-copy-link={url}
    class="dg-copy-link inline-flex items-center gap-1.5 rounded-md border border-sea-300 px-3 py-1.5 text-sm font-medium text-sea-700 hover:bg-sea-50"
  >
    Copiar link
  </button>
</div>

<script>
  // Módulo: já executa depois que o HTML dos botões acima existe no DOM.
  document.querySelectorAll<HTMLButtonElement>('.dg-copy-link').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.copyLink;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = button.textContent;
        button.textContent = 'Link copiado!';
        setTimeout(() => {
          button.textContent = original;
        }, 2000);
      } catch {
        // clipboard indisponível — o link segue selecionável normalmente na barra de endereço.
      }
    });
  });
</script>
