---
// Nomes e códigos das rodovias conferidos nos dados do OpenStreetMap (rotas OSRM).
import { Image } from 'astro:assets';
import MapCredit from './MapCredit.astro';
import mapaAcessos from '../assets/mapas/mapa-como-chegar.svg';
import { DISTANCIAS } from '../data/distancias';

const acessos = [
  {
    titulo: 'De São Paulo e do ABC (de carro, sem balsa)',
    texto:
      'Desça a serra pela Rodovia dos Imigrantes (SP-160) ou pela Via Anchieta (SP-150) até Cubatão e siga pela Rodovia Cônego Domênico Rangoni (SP-055) até a entrada da cidade (SPA-248/055).',
  },
  {
    titulo: 'De Santos e do Litoral Sul',
    texto:
      'A Balsa Santos–Guarujá leva veículos e pedestres. Quem está a pé também pode atravessar de catraia ou barca até Vicente de Carvalho. De carro, sem balsa, dá para contornar por Cubatão pela Rodovia Cônego Domênico Rangoni.',
  },
  {
    titulo: 'Do Litoral Norte e do Rio de Janeiro',
    texto:
      'Pela Rio-Santos (SP-055/BR-101) até Bertioga. De lá, atravesse pela Balsa Bertioga–Guarujá e siga pela SP-061, ou continue pela Rodovia Cônego Domênico Rangoni até a entrada do Guarujá, sem balsa.',
  },
];
---

<section aria-labelledby="como-chegar-heading" class="bg-sea-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="como-chegar-heading" class="text-2xl font-bold text-sea-900">Como chegar ao Guarujá</h2>
    <p class="mt-2 max-w-3xl text-sea-700">
      Por estar numa ilha, o Guarujá tem três portas de entrada: a rodovia pelo continente, a balsa
      de Santos e a balsa de Bertioga.
    </p>

    <div class="mt-6 grid gap-8 lg:grid-cols-5">
      <figure class="lg:col-span-3">
        <Image
          src={mapaAcessos}
          alt="Esquema das vias de acesso ao Guarujá: Rodovia dos Imigrantes e Via Anchieta de São Paulo até Cubatão, Rodovia Cônego Domênico Rangoni até o Guarujá e até Bertioga, Rio-Santos pelo litoral norte, balsas de Santos e de Bertioga e catraias de Santos para Vicente de Carvalho"
          class="w-full rounded-xl border border-sea-100 bg-white"
        />
        <MapCredit href={mapaAcessos.src} />
      </figure>

      <div class="lg:col-span-2">
        <ul class="space-y-5">
          {
            acessos.map((a) => (
              <li>
                <h3 class="font-bold text-sea-900">{a.titulo}</h3>
                <p class="mt-1 text-sm text-sea-800">{a.texto}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-xs text-sea-600">
          Horários, tarifas e tempo de espera das balsas mudam com frequência e na alta temporada.
          Confira nos canais oficiais antes de sair.
        </p>
      </div>
    </div>

    <h3 class="mt-10 text-lg font-bold text-sea-900">Distância das principais cidades de São Paulo</h3>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full max-w-2xl text-left text-sm">
        <thead>
          <tr class="border-b border-sea-200 text-sea-900">
            <th scope="col" class="py-2 pr-4 font-semibold">Cidade</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Distância por estrada</th>
          </tr>
        </thead>
        <tbody class="text-sea-800">
          {
            DISTANCIAS.map((d) => (
              <tr class="border-b border-sea-100">
                <td class="py-2 pr-4">{d.cidade}</td>
                <td class="py-2 pr-4">
                  cerca de {d.km} km{d.observacao && <span class="text-sea-600"> ({d.observacao})</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 max-w-2xl text-xs text-sea-600">
      Distâncias aproximadas por estrada, do centro de cada cidade até o centro do Guarujá, calculadas
      com dados do{' '}
      <a href="https://www.openstreetmap.org/copyright" class="underline underline-offset-2" rel="noopener">
        OpenStreetMap
      </a>
      . O trajeto real pode variar conforme a rota escolhida.
    </p>
  </div>
</section>
