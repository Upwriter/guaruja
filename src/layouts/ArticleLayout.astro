---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import AdSlot from '../components/AdSlot.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getArticleUrl, estimateReadingTime, type Article } from '../lib/articles';
import { getCategory } from '../consts';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../lib/seo';

interface Props {
  entry: Article;
  headings: MarkdownHeading[];
  related: Article[];
}

const { entry, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, faq, category } = entry.data;
const categoryInfo = getCategory(category);
const url = getArticleUrl(entry);
const readingMinutes = estimateReadingTime(entry.body);

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: categoryInfo?.label ?? category, url: `/${category}/` },
  { name: title, url },
];

const structuredData = [
  articleJsonLd({
    title,
    description,
    url,
    pubDate,
    updatedDate,
    image: heroImage?.src,
  }),
  breadcrumbJsonLd(breadcrumbItems),
  ...(faq && faq.length > 0 ? [faqJsonLd(faq)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={heroImage?.src}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt ?? ''}
          width={1024}
          height={576}
          class="mb-6 w-full rounded-xl object-cover"
          priority
        />
      )
    }

    <h1 class="text-3xl font-extrabold text-sea-900 sm:text-4xl">{title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-x-1 gap-y-1 text-sm text-sea-600">
      <span>Publicado em <FormattedDate date={pubDate} /></span>
      {
        updatedDate && (
          <span>
            &nbsp;· Atualizado em <FormattedDate date={updatedDate} />
          </span>
        )
      }
      <span>&nbsp;· {readingMinutes} min de leitura</span>
    </div>

    <TableOfContents headings={headings} />

    <div class="prose prose-article mt-6 max-w-none">
      <slot />
    </div>

    {
      faq && faq.length > 0 && (
        <section aria-labelledby="faq-heading" class="mt-10 border-t border-sea-100 pt-8">
          <h2 id="faq-heading" class="text-2xl font-bold text-sea-900">
            Perguntas frequentes
          </h2>
          <dl class="mt-4 space-y-5">
            {faq.map((item) => (
              <div>
                <dt class="font-semibold text-sea-900">{item.question}</dt>
                <dd class="mt-1 text-sea-700">{item.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <ShareButtons url={absoluteUrl(url)} title={title} />

    <AdSlot position="final-do-artigo" />
  </article>

  <RelatedArticles articles={related} />
</BaseLayout>
