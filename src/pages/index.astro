---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ImageCredit from '../components/ImageCredit.astro';
import CityMaps from '../components/CityMaps.astro';
import HowToGetThere from '../components/HowToGetThere.astro';
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPublishedArticles } from '../lib/articles';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';
import heroPhoto from '../assets/guaruja/guaiuba-panoramio.jpg';

const articles = await getPublishedArticles();
const latest = articles.slice(0, 6);
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  structuredData={[websiteJsonLd(), organizationJsonLd()]}
>
  <section class="bg-gradient-to-b from-sea-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <h1 class="text-4xl font-extrabold tracking-tight text-sea-900 sm:text-5xl">
        Seu guia completo para curtir o Guarujá
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-sea-700">
        Praias, passeios, trilhas, onde ficar e onde comer: tudo para planejar sua próxima viagem
        ao litoral de São Paulo.
      </p>
    </div>
    <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
      <Image
        src={heroPhoto}
        alt="Vista aérea da praia e do bairro de Guaiúba, no Guarujá, com mar azul e vegetação ao redor"
        width={1600}
        height={600}
        class="w-full rounded-2xl object-cover"
        priority
      />
      <ImageCredit file="guaiuba-panoramio.jpg" />
    </div>
  </section>

  <section aria-labelledby="categorias-heading" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="categorias-heading" class="text-2xl font-bold text-sea-900">Explore por categoria</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        CATEGORIES.map((cat) => (
          <a
            href={`/${cat.slug}/`}
            class="rounded-xl border border-sea-100 bg-white p-5 shadow-sm transition hover:shadow-md"
          >
            <p class="font-bold text-sea-900">{cat.label}</p>
            <p class="mt-1 text-sm text-sea-700">{cat.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="ultimos-heading" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-center justify-between">
      <h2 id="ultimos-heading" class="text-2xl font-bold text-sea-900">Últimos artigos</h2>
      <a href="/blog/" class="text-sm font-medium text-sea-700 hover:underline">Ver tudo</a>
    </div>
    {
      latest.length > 0 ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latest.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-sea-600">
          Em breve, os primeiros artigos serão publicados por aqui. Volte logo!
        </p>
      )
    }
  </section>

  <CityMaps />
  <HowToGetThere />
</BaseLayout>
