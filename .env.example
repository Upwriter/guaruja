# Copie este arquivo para ".env" (local) ou configure estas variáveis
# diretamente no painel da Vercel (Settings > Environment Variables).
# Enquanto estiverem vazias, os anúncios e o Analytics ficam DESATIVADOS.

# ID do cliente do Google AdSense (formato: ca-pub-XXXXXXXXXXXXXXXX)
PUBLIC_ADSENSE_CLIENT_ID=

# ID de métricas do Google Analytics 4 (formato: G-XXXXXXXXXX)
PUBLIC_GA_ID=
